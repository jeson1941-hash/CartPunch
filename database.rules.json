{
  "rules": {
    ".read": false,
    ".write": false,
    "products": {
      ".read": true,
      ".write": "auth != null"
    },
    "transactions": {
      ".read": "auth != null",
      ".write": true
    },
    "carts": {
      ".read": true,
      ".write": true
    },
    "admin_otp": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}